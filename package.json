{
  "name": "flutter-component-separator",
  "displayName": "Flutter Component Separator",
  "description": "Separates Flutter components into individual files",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.separateFlutterComponents",
    "onCommand:extension.convertToStatelessWidget",
    "onCommand:extension.refactorFlutter",
    "onLanguage:dart"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Flutter Component Separator",
      "properties": {
        "flutterComponentSeparator.defaultOperation": {
          "type": "string",
          "default": "ask",
          "enum": ["ask", "separate", "convert", "refactor"],
          "enumDescriptions": [
            "Always show the operation picker",
            "Automatically run Separate Components when available",
            "Automatically run Convert to StatelessWidget when available",
            "Automatically run Full Refactor when available"
          ],
          "description": "Default operation to run when triggering the extension"
        },
        "flutterComponentSeparator.componentsFolderName": {
          "type": "string",
          "default": "components",
          "description": "Folder name for separated component files"
        },
        "flutterComponentSeparator.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show status bar item when a Dart file with widgets is active"
        }
      }
    },
    "commands": [
      {
        "command": "extension.separateFlutterComponents",
        "title": "Separate Components into Files",
        "category": "Flutter",
        "icon": "$(files)"
      },
      {
        "command": "extension.convertToStatelessWidget",
        "title": "Convert StatefulWidget to StatelessWidget",
        "category": "Flutter",
        "icon": "$(symbol-class)"
      },
      {
        "command": "extension.refactorFlutter",
        "title": "Full Refactor (Interactive Preview)",
        "category": "Flutter",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .dart",
          "command": "extension.separateFlutterComponents",
          "group": "2_flutter@1"
        },
        {
          "when": "resourceExtname == .dart",
          "command": "extension.convertToStatelessWidget",
          "group": "2_flutter@2"
        },
        {
          "when": "resourceExtname == .dart",
          "command": "extension.refactorFlutter",
          "group": "2_flutter@3"
        }
      ],
      "editor/context": [
        {
          "when": "resourceExtname == .dart",
          "command": "extension.separateFlutterComponents",
          "group": "2_flutter@1"
        },
        {
          "when": "resourceExtname == .dart",
          "command": "extension.convertToStatelessWidget",
          "group": "2_flutter@2"
        },
        {
          "when": "resourceExtname == .dart",
          "command": "extension.refactorFlutter",
          "group": "2_flutter@3"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .dart",
          "command": "extension.refactorFlutter",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^14.x",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "eslint": "^8.26.0",
    "typescript": "^4.8.4",
    "@vscode/test-electron": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abdulmominsakib/flutter-component-separator.git"
  },
  "license": "MIT",
  "publisher": "AbdulMominSakib"
}